{% extends 'base.html.twig' %}

{% block title %}Inscription — Mangaverse{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 450px;">
    <div class="text-center mb-4">
        <img src="{{ asset('images/logo.png') }}" alt="Logo" style="height: 80px;">
        <h1 class="mt-3">Créer un compte</h1>
    </div>

    <div class="card" style="background: rgba(20,20,20,0.92); border: 1px solid var(--gold); border-radius: 16px;">
        <div class="card-body p-4">

            {{ form_errors(registrationForm) }}

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Nom complet</label>
                    {{ form_widget(registrationForm.nom, {'attr': {'class': 'form-control', 'style': 'background: rgba(255,255,255,0.08); border: 1px solid var(--gold); color: #fff;'}}) }}
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'form-control', 'style': 'background: rgba(255,255,255,0.08); border: 1px solid var(--gold); color: #fff;'}}) }}
                </div>

                <div class="mb-3">
                    <label class="form-label">Mot de passe</label>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'form-control', 'style': 'background: rgba(255,255,255,0.08); border: 1px solid var(--gold); color: #fff;'}}) }}
                </div>

                <div class="mb-3 form-check">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
                    <label class="form-check-label" style="color: #ccc;">J'accepte les conditions d'utilisation</label>
                </div>

                {{ form_rest(registrationForm) }}

                <button class="btn btn-gold w-100 py-2 mt-2" type="submit">Créer mon compte</button>
            </form>

            <hr style="border-color: #444;">
            <p class="text-center mb-0" style="font-size: 0.9rem; color: #ccc;">
                Déjà un compte ? <a href="{{ path('app_login') }}" style="color: var(--gold);">Se connecter</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}