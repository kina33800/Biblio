{% extends 'base.html.twig' %}

{% block title %}Statistiques des Emprunts{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>Tableau de bord de la Bibliothèque</h1>
    <hr>

    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card border-primary mb-3">
                <div class="card-header bg-primary text-white"> Emprunts en cours</div>
                <div class="card-body">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Livre</th>
                                <th>Date d'emprunt</th>
                                <th>Date retour</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for emprunt in empruntsEnCours %}
                        <tr>
                            <td>{{ emprunt.book.titre }}</td>
                            <td>{{ emprunt.dateEmprunt|date('d/m/Y') }}</td>
                            <td>
                                {% if emprunt.dateRetour %}
                                    {{ emprunt.dateRetour|date('d/m/Y') }}
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center">Aucun emprunt en cours.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-info mb-3">
                <div class="card-header bg-info text-white"> Top Auteurs (Emprunts)</div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Auteur</th>
                                <th>Nombre total</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for stat in statsAuteurs %}
                            <tr>
                                <td>{{ stat.auter }}</td>
                                <td><span class="badge bg-secondary">{{ stat.total }}</span></td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="2" class="text-center">Aucune donnée disponible.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <a href="{{ path('app_emprunt') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
</div>
{% endblock %}