{% extends 'base.html.twig' %}

{% block title %}Connexion — Mangaverse{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 450px;">
    <div class="text-center mb-4">
        <img src="{{ asset('images/logo.png') }}" alt="Logo" style="height: 80px;">
        <h1 class="mt-3">Connexion</h1>
    </div>

    <div class="card" style="background: rgba(20,20,20,0.92); border: 1px solid var(--gold); border-radius: 16px;">
        <div class="card-body p-4">

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}
                <div class="alert alert-info">
                    Connecté en tant que {{ app.user.userIdentifier }} — <a href="{{ logout_path() }}">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post">
                <div class="mb-3">
                    <label for="username" class="form-label">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username"
                           class="form-control" autocomplete="email" required autofocus
                           style="background: rgba(255, 12, 12, 0.08); border: 1px solid var(--gold); color: #fff;">
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input type="password" name="_password" id="password"
                           class="form-control" autocomplete="current-password" required
                           style="background: rgba(255,255,255,0.08); border: 1px solid var(--gold); color: #fff;">
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" name="_remember_me" id="_remember_me" class="form-check-input">
                    <label for="_remember_me" class="form-check-label" style="color: var(--gold);">Se souvenir de moi</label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn btn-gold w-100 py-2" type="submit">Se connecter</button>
            </form>

            <hr style="border-color: #444;">
            <p class="text-center mb-0" style="font-size: 0.9rem; color: #ccc;">
                Pas encore de compte ? <a href="{{ path('app_register') }}" style="color: var(--gold);">S'inscrire</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}