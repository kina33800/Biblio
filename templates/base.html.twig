<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Bibliothèque{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📚</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
        <style>
            body {
                background-image: url("{{ asset('images/background.png') }}");
                background-size: cover;
                background-attachment: fixed;
                background-position: center;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            main {
                flex: 1;
            }

            .container {
                border-radius: 10px;
                padding: 20px;
            }

            .navbar {
                background-color: rgba(0, 0, 0, 0.85) !important;
            }

            .navbar-brand img {
                height: 40px;
                object-fit: contain;
                margin-right: 8px;
            }

            footer {
                background-color: rgba(0, 0, 0, 0.88);
                color: #ccc;
                padding: 40px 0 20px;
                margin-top: auto;
            }

            footer h5 {
                color: #fff;
                font-weight: bold;
                margin-bottom: 15px;
            }

            footer a {
                color: #aaa;
                text-decoration: none;
            }

            footer a:hover {
                color: #fff;
            }

            footer .social-icons a {
                font-size: 1.4rem;
                margin-right: 12px;
                color: #aaa;
            }

            footer .social-icons a:hover {
                color: #fff;
            }

            footer hr {
                border-color: #444;
            }

            footer .copyright {
                color: #777;
                font-size: 0.85rem;
            }
            h1 {
                background-color: rgba(0, 0, 0, 0.85);
                color: white;
                display: inline-block;
                padding: 4px 12px;
                border-radius: 6px;
            }
            .cover-container:hover .cover-popup {
                display: block;
            }

            .cover-popup {
                display: none;
                position: absolute;
                top: 0;
                left: 90px;
                width: 250px;
                background: rgba(0,0,0,0.88);
                color: #fff;
                padding: 10px;
                border-radius: 8px;
                z-index: 999;
                box-shadow: 0 4px 15px rgba(0,0,0,0.4);
            }
            form button[type="submit"] {
                border: 2px solid #dc3545 !important;
                color: #dc3545 !important;
                background: transparent !important;
                font-weight: bold;
            }

            form button[type="submit"]:hover {
                background: #dc3545 !important;
                color: white !important;
            }
        </style>
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>

        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-dark mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" href="{{ path('app_book_index') }}">
                    <img src="{{ asset('images/logo.png') }}" alt="Logo" style="height: 85px; object-fit: contain; margin-right: 10px;">
                    <span>Bibliothèque Manga</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <div class="navbar-nav ms-auto">
                        <a class="nav-link" href="{{ path('app_book_index') }}">📚 Catalogue</a>
                        <a class="nav-link" href="{{ path('app_book_new') }}">➕ Ajouter Livre</a>
                        <a class="nav-link" href="{{ path('app_emprunt') }}">📋 Emprunts</a>
                        <a class="nav-link" href="{{ path('app_emprunt_stats') }}">📊 Stats</a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- CONTENU -->
        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- FOOTER -->
        <footer>
            <div class="container">
                <div class="row">

                    <!-- Colonne 1 : Liens rapides -->
                    <div class="col-md-4 mb-4">
                        <h5>🔗 Liens rapides</h5>
                        <ul class="list-unstyled">
                            <li><a href="{{ path('app_book_index') }}">📚 Catalogue</a></li>
                            <li><a href="{{ path('app_book_new') }}">➕ Ajouter un livre</a></li>
                            <li><a href="{{ path('app_emprunt') }}">📋 Emprunts en cours</a></li>
                            <li><a href="{{ path('app_emprunt_stats') }}">📊 Statistiques</a></li>
                        </ul>
                    </div>

                    <!-- Colonne 2 : Infos -->
                    <div class="col-md-4 mb-4">
                        <h5>ℹ️ À propos</h5>
                        <p> Mangaverse est une application de gestion d'emprunts de mangas développée avec Symfony.</p>
                        <p>📍 Bordeaux, France</p>
                        <p>📧 contact@mangaverse.fr</p>
                    </div>

                    <!-- Colonne 3 : Réseaux sociaux -->
                    <!-- Colonne 3 : Réseaux sociaux + logo ancre -->
                    <div class="col-md-4 mb-4 text-center">
                        <h5>🌐 Réseaux sociaux</h5>
                        <div class="social-icons mb-4">
                            <a href="#" title="Twitter/X"><i class="fab fa-x-twitter"></i></a>
                            <a href="#" title="Instagram"><i class="fab fa-instagram"></i></a>
                            <a href="#" title="Discord"><i class="fab fa-discord"></i></a>
                            <a href="https://github.com/kina33800/Biblio" title="GitHub"><i class="fab fa-github"></i></a>
                        </div>

                        <!-- Logo ancre qui remonte en haut -->
                        <a href="{{ path('app_book_index') }}" title="Retour en haut">
                            <img src="{{ asset('images/logo.png') }}" alt="Logo" 
                                style="height: 60px; object-fit: contain; opacity: 0.8; transition: opacity 0.3s;">
                        </a>
                        <br>
                        <small style="color: #666;">↑ Retour au catalogue</small>
                    </div>

                </div>

                <hr>
                <p class="text-center copyright">© {{ "now"|date("Y") }} Bibliothèque Manga — Tous droits réservés</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>