{% extends 'base.html.twig' %}

{% block title %}Catalogue des Livres{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>📚 Catalogue des Livres</h1>
        <div>
            <a href="{{ path('app_book_new') }}" class="btn btn-success">+ Ajouter Livre</a>
            <a href="{{ path('app_emprunt') }}" class="btn btn-outline-primary ms-2">Emprunts</a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Couverture</th>
                <th>Titre</th>
                <th>Auteur</th>
                <th>ISBN</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>
                    {% if book.image %}
                        <div class="position-relative d-inline-block cover-container">
                            <img src="{{ book.image }}" alt="{{ book.titre }}" 
                                style="height: 80px; object-fit: cover; border-radius: 4px; cursor: pointer;">
                            {% if book.aperçu %}
                            <div class="cover-popup">
                                <p class="mb-0" style="font-size: 0.8rem;">{{ book.aperçu }}</p>
                            </div>
                            {% endif %}
                        </div>
                    {% else %}
                        <span class="text-muted">—</span>
                    {% endif %}
                </td>
                <td>{{ book.titre }}</td>
                <td>{{ book.auter }}</td>
                <td>{{ book.isbn }}</td>
                <td>
                    {% if book.stock > 0 %}
                        <span class="text-success fw-bold">{{ book.stock }}</span>
                    {% else %}
                        <span class="text-danger fw-bold">0</span>
                        {% set retour = bookRepository.findProchainRetour(book.id) %}
                        {% if retour and retour.dateRetour %}
                            <br><small class="text-muted">
                                📅 Retour prévu le {{ retour.dateRetour|date('d/m/Y') }}
                            </small>
                        {% else %}
                            <br><small class="text-muted">⚠️ Aucune date de retour connue</small>
                        {% endif %}
                    {% endif %}
                </td>
                    <td>
                        <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-sm btn-info">👁 Voir</a>
                        <a href="{{ path('app_emprunt_new', {'id': book.id}) }}" class="btn btn-sm btn-primary">EMPRUNTER</a>
                        <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-sm btn-warning">Éditer</a>
                        <form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ce livre ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                            <button class="btn btn-sm btn-danger">Supprimer</button>
                        </form>
                    </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5" class="text-center">Aucun livre dans le catalogue.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

</div>
{% endblock %}