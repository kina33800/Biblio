{% extends 'base.html.twig' %}

{% block title %}{{ book.titre }}{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="row">
        <!-- Couverture -->
        <div class="col-md-3 text-center">
            {% if book.image %}
                <img src="{{ book.image }}" alt="{{ book.titre }}" 
                     class="img-fluid rounded shadow" style="max-height: 350px;">
            {% endif %}
        </div>

        <!-- Infos -->
        <div class="col-md-9">
            <h1>{{ book.titre }}</h1>
            <p class="text-muted fs-5">✍️ {{ book.auter }}</p>
            <p><strong>ISBN :</strong> {{ book.isbn }}</p>
            <p>
                <strong>Stock :</strong>
                {% if book.stock > 0 %}
                    <span class="text-success fw-bold">{{ book.stock }} disponible(s)</span>
                {% else %}
                    <span class="text-danger fw-bold">Stock épuisé</span>
                {% endif %}
            </p>

            {% if book.aperçu %}
            <div class="mt-3 p-3" style="background: #f8f9fa; border-left: 4px solid #dc3545; border-radius: 4px;">
                <h5>📖 Synopsis</h5>
                <p class="mb-0">{{ book.aperçu }}</p>
            </div>
            {% endif %}

            <div class="mt-4 d-flex gap-2">
                {% if book.stock > 0 %}
                    <a href="{{ path('app_emprunt_new', {id: book.id}) }}" class="btn btn-primary">📖 EMPRUNTER</a>
                {% endif %}
                <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-warning">✏️ Modifier</a>
                {{ include('book/_delete_form.html.twig') }}
                <a href="{{ path('app_book_index') }}" class="btn btn-secondary">← Retour</a>
            </div>
        </div>
    </div>

</div>
{% endblock %}