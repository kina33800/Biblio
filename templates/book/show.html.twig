{% extends 'base.html.twig' %}

{% block title %}{{ book.titre }}{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 960px;">

    <!-- INFOS LIVRE -->
    <div class="row mb-5" style="background: rgba(20,20,20,0.85); border: 1px solid var(--gold); border-radius: 16px; padding: 30px;">
        
        <!-- Couverture -->
        <div class="col-md-3 text-center mb-3 mb-md-0">
            {% if book.image %}
                <img src="{{ book.image }}" alt="{{ book.titre }}"
                     style="width: 100%; max-width: 180px; border-radius: 10px; border: 2px solid var(--gold); box-shadow: 0 8px 25px rgba(201,168,76,0.3);">
            {% else %}
                <div style="width:180px; height:260px; background: var(--noir-soft); border-radius:10px; border: 2px solid var(--gold); display:flex; align-items:center; justify-content:center; font-size:3rem; margin: 0 auto;">📚</div>
            {% endif %}
        </div>

        <!-- Détails -->
        <div class="col-md-9">
            <h1 style="font-size: 1.8rem; margin-bottom: 6px;">{{ book.titre }}</h1>
            <p style="color: #aaa; font-size: 1rem; margin-bottom: 16px;">✍️ {{ book.auter }}</p>

            <div class="d-flex gap-4 mb-3" style="font-size: 0.9rem; color: #ccc;">
                <span><strong style="color: var(--gold);">ISBN</strong><br>{{ book.isbn }}</span>
                <span>
                    <strong style="color: var(--gold);">Stock</strong><br>
                    {% if book.stock > 0 %}
                        <span style="color: #4caf50;">✅ {{ book.stock }} dispo</span>
                    {% else %}
                        <span style="color: #f44336;">❌ Épuisé</span>
                    {% endif %}
                </span>
                {% if moyenne %}
                <span>
                    <strong style="color: var(--gold);">Note</strong><br>
                    {% for i in 1..5 %}{% if i <= moyenne %}⭐{% else %}☆{% endif %}{% endfor %}
                    <small style="color: #888;">({{ book.commentaires|length }})</small>
                </span>
                {% endif %}
            </div>

            {% if book.aperçu %}
            <div class="mb-4 p-3" style="background: rgba(201,168,76,0.07); border-left: 3px solid var(--gold); border-radius: 0 8px 8px 0;">
                <p style="color: #ccc; font-size: 0.88rem; line-height: 1.7; margin: 0;">{{ book.aperçu }}</p>
            </div>
            {% endif %}

            <div class="d-flex flex-wrap gap-2">
                {% if book.stock > 0 %}
                    <a href="{{ path('app_emprunt_new', {id: book.id}) }}" class="btn btn-gold">📖 Emprunter</a>
                {% endif %}
                <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-warning">✏️ Modifier</a>
                {{ include('book/_delete_form.html.twig') }}
                <a href="{{ path('app_book_index') }}" class="btn btn-outline-gold">← Retour</a>
            </div>
        </div>
    </div>

    <!-- SECTION COMMENTAIRES -->
    <div class="row gap-4 flex-column">

        <!-- FORMULAIRE -->
        <div class="col-12">
            <div style="background: rgba(20,20,20,0.85); border: 1px solid var(--gold); border-radius: 16px; padding: 28px;">
                <h5 style="color: var(--gold); margin-bottom: 20px;">✍️ Laisser un avis</h5>

                {% if app.user %}
                    <form method="post" action="{{ path('app_book_commentaire', {'id': book.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('commentaire' ~ book.id) }}">

                        <!-- Étoiles -->
                        <div class="mb-3">
                            <label style="color: var(--gold); font-weight: 600; display: block; margin-bottom: 10px;">Note</label>
                            <div class="d-flex gap-3">
                                {% for i in 1..5 %}
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="commentaire[note]" id="note{{ i }}" value="{{ i }}"
                                           style="accent-color: var(--gold);">
                                    <label class="form-check-label" for="note{{ i }}" style="color: #ccc;">
                                    {% for s in 1..i %}⭐{% endfor %}
                                    </label>
                                </div>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Commentaire -->
                        <div class="mb-3">
                            <label style="color: var(--gold); font-weight: 600; display: block; margin-bottom: 8px;">Commentaire</label>
                            <textarea name="commentaire[contenu]" rows="4" class="form-control"
                                      placeholder="Partagez votre avis..."
                                      style="background: rgba(255,255,255,0.06); border: 1px solid rgba(201,168,76,0.4); color: #fff; border-radius: 8px; resize: vertical;"></textarea>
                        </div>

                        <button type="submit" class="btn btn-gold px-4">Publier</button>
                    </form>
                {% else %}
                    <p style="color: #aaa; margin: 0;">
                        <a href="{{ path('app_login') }}" style="color: var(--gold);">Connectez-vous</a> pour laisser un avis.
                    </p>
                {% endif %}
            </div>
        </div>

        <!-- LISTE COMMENTAIRES -->
        <div class="col-12">
            <div style="background: rgba(20,20,20,0.85); border: 1px solid rgba(201,168,76,0.3); border-radius: 16px; padding: 28px;">
                <h5 style="color: var(--gold); margin-bottom: 20px;">
                    💬 Commentaires
                    {% if book.commentaires|length > 0 %}
                        <span style="font-size: 0.8rem; color: #888; font-weight: 400;">— {{ book.commentaires|length }} avis</span>
                    {% endif %}
                </h5>

                {% if book.commentaires is empty %}
                    <p style="color: #666; text-align: center; padding: 20px 0;">Aucun commentaire pour le moment.</p>
                {% else %}
                    <div class="d-flex flex-column gap-3">
                        {% for commentaire in book.commentaires %}
                        <div style="background: rgba(255,255,255,0.04); border: 1px solid rgba(201,168,76,0.15); border-radius: 10px; padding: 16px;">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong style="color: var(--gold); font-size: 0.9rem;">👤 {{ commentaire.user.nom }}</strong>
                                <small style="color: #555;">{{ commentaire.createdAt|date('d/m/Y') }}</small>
                            </div>
                            <div style="margin-bottom: 8px; font-size: 0.9rem;">
                                {% for i in 1..5 %}{% if i <= commentaire.note %}⭐{% else %}<span style="color:#444;">☆</span>{% endif %}{% endfor %}
                            </div>
                            <p style="color: #bbb; font-size: 0.88rem; line-height: 1.6; margin: 0;">{{ commentaire.contenu }}</p>
                        </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

    </div>
</div>
{% endblock %}