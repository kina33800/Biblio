{% extends 'base.html.twig' %}

{% block title %}Nouveau Livre{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 500px;">

    <div class="text-center mb-4">
        <h1>➕ Nouveau Livre</h1>
    </div>

    <div class="card" style="background: rgba(20,20,20,0.92); border: 1px solid var(--gold); border-radius: 16px;">
        <div class="card-body p-4">
            {{ include('book/_form.html.twig') }}
        </div>
    </div>

    <div class="text-center mt-3">
        <a href="{{ path('app_book_index') }}" class="btn btn-outline-gold">← Retour au catalogue</a>
    </div>

</div>
{% endblock %}